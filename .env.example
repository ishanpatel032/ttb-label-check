# Copy to .env and fill in the block for your provider. Never commit the real file.
# PROVIDER selects which one is used: anthropic | openai | azure | gemini

PROVIDER=anthropic

# --- anthropic ---
ANTHROPIC_API_KEY=
# MODEL=claude-sonnet-5

# --- openai ---
# OPENAI_API_KEY=
# MODEL=gpt-4o

# --- azure (this is the path for a real deployment; in Azure Government the
#     endpoint host ends in .azure.us) ---
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=your-vision-deployment-name
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- gemini ---
# GEMINI_API_KEY=
# MODEL=gemini-2.5-flash

# How many labels in a batch are sent at once. Lower this on a free tier.
BATCH_CONCURRENCY=8
